# Convex
VITE_CONVEX_URL=

# Shopify (for embedded app)
VITE_SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_SHOP=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
# Comma-separated list of allowed sales channels (leave empty to sync all channels)
# Example: SHOPIFY_ALLOWED_CHANNELS=Online Store,Point of Sale
SHOPIFY_ALLOWED_CHANNELS=

# Amazon SP-API
AMAZON_REFRESH_TOKEN=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# eBay API (OAuth)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://YOUR_DEPLOYMENT_NAME.convex.site/ebay/callback
EBAY_ENVIRONMENT=PRODUCTION
EBAY_VERIFICATION_TOKEN=
# Frontend variables for eBay OAuth
VITE_EBAY_CLIENT_ID=
VITE_EBAY_ENVIRONMENT=PRODUCTION

# TikTok Shop Partner API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR_DEPLOYMENT_NAME.convex.site/tiktok/callback
# Optional. Defaults to https://open-api.tiktokglobalshop.com
# US apps: https://open-api.us.tiktokglobalshop.com (also switches the authorize host)
TIKTOK_API_BASE=
# Optional. US authorize uses Service ID from Partner Center; falls back to App Key
TIKTOK_SERVICE_ID=
